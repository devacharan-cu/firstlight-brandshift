{
  "name": "firstlight-brandshift",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run tests/solver.test.ts tests/ops.test.ts tests/csv.test.ts",
    "bench": "vitest run tests/bench.test.ts",
    "check:browser": "node scripts/shoot.mjs && node scripts/a11y-check.mjs",
    "check:sweep": "node scripts/shoot.mjs",
    "check:a11y": "node scripts/a11y-check.mjs",
    "check:paint": "node scripts/paint.mjs",
    "shots:case": "node scripts/case-shots.mjs",
    "media": "node scripts/media.mjs"
  },
  "dependencies": {
    "@fontsource/overpass": "^5.3.0",
    "@fontsource/overpass-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.13.0",
    "puppeteer-core": "^25.16.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
